@tailwind base;
@tailwind components;
@tailwind utilities;

body {
  min-width: 320px;
  min-height: 100vh;
  color: #f5eafa;
  background-color: #08050d;
  background-image:
    radial-gradient(ellipse at 50% -15%, rgba(114, 35, 136, 0.34), transparent 58%),
    radial-gradient(ellipse at 96% 17%, rgba(218, 66, 14, 0.13), transparent 31%),
    radial-gradient(ellipse at 4% 72%, rgba(49, 103, 58, 0.09), transparent 30%),
    linear-gradient(180deg, rgba(8, 5, 13, 0.88), rgba(8, 5, 13, 0.98)),
    url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.8' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.16'/%3E%3C/svg%3E");
  background-attachment: fixed;
  font-family: Roboto, sans-serif;
}

body::before,
body::after {
  position: fixed;
  z-index: 4;
  top: 0;
  width: min(13rem, 34vw);
  height: min(13rem, 34vw);
  content: "";
  pointer-events: none;
  opacity: 0.25;
  background-image:
    repeating-conic-gradient(from 2deg at 0 0, transparent 0deg 14deg, rgba(196, 145, 216, 0.34) 14.3deg 14.8deg, transparent 15deg 28deg),
    repeating-radial-gradient(circle at 0 0, transparent 0 15px, rgba(196, 145, 216, 0.26) 15.5px 16.3px, transparent 16.8px 29px);
  mask-image: linear-gradient(135deg, #000 0%, transparent 76%);
}

body::before {
  left: 0;
}

body::after {
  right: 0;
  transform: scaleX(-1);
}

.app-shell {
  isolation: isolate;
}

.app-shell > :not(.haunting-atmosphere) {
  position: relative;
  z-index: 1;
}

.haunting-atmosphere {
  position: fixed;
  z-index: 0;
  inset: 0;
  overflow: hidden;
  pointer-events: none;
}

.haunting-atmosphere::before,
.haunting-atmosphere::after {
  position: absolute;
  inset: 0;
  content: "";
}

.haunting-atmosphere::before {
  background:
    radial-gradient(ellipse at 84% 14%, rgba(255, 101, 34, 0.09), transparent 21rem),
    radial-gradient(ellipse at 12% 83%, rgba(88, 30, 115, 0.14), transparent 28rem);
  animation: haunted-glow 13s ease-in-out infinite alternate;
}

.haunting-atmosphere::after {
  background: linear-gradient(112deg, transparent 12%, rgba(215, 224, 255, 0.22) 46%, transparent 48%);
  opacity: 0;
  animation: distant-lightning 17s linear infinite;
}

.blood-moon {
  position: absolute;
  top: 7vh;
  right: 10vw;
  width: clamp(5rem, 11vw, 10rem);
  aspect-ratio: 1;
  border: 1px solid rgba(255, 173, 117, 0.25);
  border-radius: 50%;
  background:
    radial-gradient(circle at 35% 31%, rgba(255, 219, 169, 0.78), transparent 3%),
    radial-gradient(circle at 64% 59%, rgba(98, 31, 51, 0.34) 0 7%, transparent 8%),
    radial-gradient(circle at 31% 70%, rgba(104, 35, 49, 0.28) 0 11%, transparent 12%),
    radial-gradient(circle at 42% 38%, #d57b63, #873c50 52%, #361829 78%);
  box-shadow: 0 0 2.5rem rgba(211, 76, 49, 0.25), 0 0 8rem rgba(171, 49, 56, 0.17);
  opacity: 0.58;
  animation: moon-pulse 9s ease-in-out infinite alternate;
}

.lightning-glow {
  position: absolute;
  top: 9%;
  left: 48%;
  width: 2px;
  height: 24rem;
  background: linear-gradient(180deg, rgba(215, 224, 255, 0.45), transparent);
  opacity: 0;
  transform: rotate(20deg);
  transform-origin: top;
  filter: blur(1px);
  animation: lightning-strike 19s steps(1, end) infinite;
}

.drifting-fog {
  position: absolute;
  left: -40%;
  width: 180%;
  height: 11rem;
  border-radius: 50%;
  background: linear-gradient(90deg, transparent 4%, rgba(110, 97, 130, 0.03) 24%, rgba(199, 183, 212, 0.11) 52%, rgba(110, 97, 130, 0.04) 76%, transparent);
  filter: blur(42px);
  opacity: 0.7;
}

.fog-low {
  bottom: 8%;
  animation: fog-drift 42s ease-in-out infinite alternate;
}

.fog-high {
  top: 37%;
  height: 7rem;
  opacity: 0.38;
  animation: fog-drift 58s ease-in-out -16s infinite alternate-reverse;
}

.flying-bat {
  position: absolute;
  top: 22%;
  left: -5rem;
  width: 2rem;
  fill: #07060c;
  filter: drop-shadow(0 0 7px rgba(109, 74, 128, 0.28));
  animation: bat-flight 32s linear infinite;
}

.bat-two {
  top: 34%;
  width: 1.35rem;
  opacity: 0.7;
  animation-duration: 43s;
  animation-delay: -18s;
}

.ember {
  position: absolute;
  bottom: 13%;
  left: 18%;
  width: 5px;
  height: 5px;
  border-radius: 50%;
  background: #ff9a4a;
  box-shadow: 0 0 12px 3px rgba(255, 114, 35, 0.48);
  animation: ember-rise 9s ease-in-out infinite;
}

.ember-two {
  left: 76%;
  bottom: 10%;
  animation-delay: -4s;
  animation-duration: 12s;
}

.ember-three {
  left: 54%;
  bottom: 7%;
  transform: scale(0.65);
  animation-delay: -7s;
  animation-duration: 11s;
}

@keyframes fog-drift {
  from { transform: translateX(-6%) scaleY(0.9); }
  to { transform: translateX(7%) scaleY(1.15); }
}

@keyframes bat-flight {
  0% { transform: translate3d(-5rem, 0, 0) scale(0.8); }
  45% { transform: translate3d(53vw, -2rem, 0) scale(1); }
  100% { transform: translate3d(calc(100vw + 6rem), 1rem, 0) scale(0.75); }
}

@keyframes ember-rise {
  0%, 100% { opacity: 0; transform: translateY(0) scale(0.7); }
  30% { opacity: 0.9; }
  80% { opacity: 0.5; transform: translateY(-45vh) scale(1.15); }
}

@keyframes haunted-glow {
  from { opacity: 0.55; }
  to { opacity: 1; }
}

@keyframes moon-pulse {
  from { opacity: 0.43; box-shadow: 0 0 2rem rgba(211, 76, 49, 0.2), 0 0 6rem rgba(171, 49, 56, 0.12); }
  to { opacity: 0.68; box-shadow: 0 0 3rem rgba(211, 76, 49, 0.34), 0 0 9rem rgba(171, 49, 56, 0.2); }
}

@keyframes lightning-strike {
  0%, 93%, 94.2%, 96%, 100% { opacity: 0; }
  93.2%, 94%, 95.1% { opacity: 0.2; }
  93.6% { opacity: 0.55; }
}

@keyframes distant-lightning {
  0%, 89%, 90%, 91%, 100% { opacity: 0; }
  89.2%, 90.4% { opacity: 0.2; }
}

button,
input,
textarea,
select {
  font: inherit;
}

button {
  cursor: pointer;
}

button:focus-visible,
input:focus-visible,
textarea:focus-visible,
select:focus-visible,
summary:focus-visible {
  outline: 2px solid #ff8533;
  outline-offset: 3px;
}

.app-shell {
  position: relative;
}

.grave-card,
.game-card {
  border: 1px solid rgba(152, 74, 184, 0.35);
  border-radius: 1.15rem;
  background: linear-gradient(145deg, rgba(28, 17, 39, 0.94), rgba(13, 9, 20, 0.92));
  box-shadow: 0 20px 55px rgba(0, 0, 0, 0.33), inset 0 1px rgba(255, 255, 255, 0.045);
  backdrop-filter: blur(16px);
}

.game-card {
  position: relative;
  overflow: hidden;
  isolation: isolate;
  border-color: rgba(159, 97, 176, 0.34);
  background: linear-gradient(155deg, rgba(37, 21, 47, 0.96), rgba(16, 10, 23, 0.98) 66%);
  transition: transform 240ms cubic-bezier(0.2, 0.8, 0.2, 1), border-color 240ms ease, box-shadow 240ms ease;
}

.game-card::before {
  position: absolute;
  z-index: -1;
  inset: 0;
  content: "";
  background:
    radial-gradient(ellipse at 50% -15%, rgba(255, 130, 54, 0.13), transparent 52%),
    linear-gradient(135deg, rgba(255, 255, 255, 0.035), transparent 48%);
  opacity: 0.75;
  transition: opacity 240ms ease;
}

.game-card > * {
  position: relative;
  z-index: 1;
}

.game-card:hover {
  transform: translateY(-6px) scale(1.012);
  border-color: rgba(255, 135, 62, 0.78);
  box-shadow: 0 21px 55px rgba(0, 0, 0, 0.43), 0 0 28px rgba(184, 73, 26, 0.17), inset 0 0 24px rgba(255, 116, 41, 0.035);
}

.game-card:hover::before {
  opacity: 1;
}

.hero-card {
  position: relative;
  display: grid;
  min-height: 26rem;
  place-items: center;
  border: 1px solid rgba(255, 122, 54, 0.62);
  border-radius: 1.5rem;
  background: #100d18;
  box-shadow: 0 24px 70px rgba(0, 0, 0, 0.58), 0 0 70px rgba(115, 36, 152, 0.2), inset 0 1px rgba(255, 255, 255, 0.1);
  isolation: isolate;
}

.hero-card::before,
.hero-card::after {
  position: absolute;
  z-index: -1;
  inset: 0;
  content: "";
}

.hero-card::before {
  background-image:
    linear-gradient(90deg, rgba(9, 7, 14, 0.72), rgba(13, 9, 18, 0.32) 50%, rgba(9, 7, 14, 0.67)),
    linear-gradient(0deg, rgba(9, 7, 14, 0.82), transparent 68%, rgba(9, 7, 14, 0.28)),
    url("/images/motz-house-fog.jpg");
  background-position: center, center, 44% 48%;
  background-size: cover, cover, 150% auto;
  opacity: 0.95;
  transform: scale(1.025);
  animation: haunted-house-breath 22s ease-in-out infinite alternate;
}

.hero-card::after {
  background:
    radial-gradient(ellipse at 50% 42%, transparent 12%, rgba(8, 6, 12, 0.3) 100%),
    radial-gradient(ellipse at 50% 0%, rgba(232, 89, 39, 0.1), transparent 54%);
  box-shadow: inset 0 -34px 75px rgba(8, 6, 12, 0.68), inset 0 0 40px rgba(113, 46, 145, 0.13);
}

.hero-content {
  position: relative;
  z-index: 1;
  width: 100%;
  text-shadow: 0 2px 18px rgba(0, 0, 0, 0.9);
}

@keyframes haunted-house-breath {
  from { background-position: center, center, 44% 48%; }
  to { background-position: center, center, 49% 46%; }
}

.hero-stamp {
  display: inline-flex;
  align-items: center;
  gap: 0.55rem;
  margin-bottom: 0.9rem;
  border: 1px solid rgba(255, 157, 89, 0.4);
  border-radius: 999px;
  background: rgba(14, 8, 15, 0.66);
  padding: 0.35rem 0.8rem;
  color: #ffc18e;
  font-size: 0.65rem;
  font-weight: 800;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  box-shadow: 0 0 22px rgba(223, 81, 33, 0.15);
}

.hero-stamp span {
  color: #ff6d28;
}

.hero-promises {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 0.55rem 1.2rem;
  margin-top: 1.6rem;
  color: rgba(242, 222, 241, 0.75);
  font-size: 0.7rem;
  letter-spacing: 0.04em;
}

.hero-promises span {
  display: inline-flex;
  align-items: center;
  gap: 0.35rem;
}

.hero-promises i {
  color: #ff8c43;
  font-size: 0.9rem;
  font-style: normal;
}

.game-shelf-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1px solid rgba(162, 97, 177, 0.24);
  margin-bottom: 1.15rem;
}

.game-shelf-heading h2 {
  margin-bottom: 0.7rem;
  text-shadow: 0 0 20px rgba(192, 97, 201, 0.22);
}

.shelf-candle {
  margin: 0 1rem 0.8rem;
  font-size: 1.8rem;
  filter: drop-shadow(0 0 12px rgba(255, 153, 54, 0.62));
  animation: candle-flicker 2.8s ease-in-out infinite alternate;
}

@keyframes candle-flicker {
  0%, 100% { filter: drop-shadow(0 0 9px rgba(255, 153, 54, 0.45)); transform: rotate(-2deg); }
  42% { filter: drop-shadow(0 0 19px rgba(255, 153, 54, 0.85)); transform: rotate(2deg) scale(1.04); }
  71% { filter: drop-shadow(0 0 11px rgba(255, 153, 54, 0.56)); transform: rotate(-1deg); }
}

.game-card-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.5rem;
  margin-bottom: 1rem;
}

.game-card-icon {
  display: grid;
  width: 3.5rem;
  height: 3.5rem;
  place-items: center;
  border: 1px solid rgba(255, 138, 64, 0.4);
  border-radius: 1.15rem;
  background: radial-gradient(circle at 35% 28%, rgba(254, 152, 80, 0.2), rgba(34, 17, 40, 0.92) 68%);
  font-size: 1.85rem;
  filter: drop-shadow(0 0 9px rgba(234, 104, 41, 0.18));
  transition: transform 240ms ease, filter 240ms ease;
}

.game-card:hover .game-card-icon {
  transform: translateY(-2px) rotate(-5deg) scale(1.08);
  filter: drop-shadow(0 0 13px rgba(255, 130, 59, 0.45));
}

.game-card-tag {
  border: 1px solid rgba(175, 126, 181, 0.28);
  border-radius: 999px;
  background: rgba(9, 7, 13, 0.55);
  padding: 0.3rem 0.5rem;
  color: rgba(223, 200, 228, 0.7);
  font-size: 0.58rem;
  font-weight: 800;
  letter-spacing: 0.1em;
  text-transform: uppercase;
}

.eyebrow {
  color: rgba(208, 167, 224, 0.7);
  font-size: 0.7rem;
  font-weight: 700;
  letter-spacing: 0.18em;
  line-height: 1.5;
  text-transform: uppercase;
}

.section-title {
  margin-bottom: 1rem;
  color: #ff8533;
  font-size: 1.25rem;
  font-weight: 700;
}

.spooky-button {
  position: relative;
  isolation: isolate;
  overflow: hidden;
  display: inline-flex;
  min-height: 2.65rem;
  align-items: center;
  justify-content: center;
  gap: 0.55rem;
  border: 1px solid rgba(255, 163, 99, 0.86);
  border-radius: 0.65rem 0.9rem 0.65rem 0.9rem;
  background:
    linear-gradient(125deg, rgba(255, 255, 255, 0.1), transparent 44%),
    linear-gradient(135deg, #9d3517, #702064 58%, #42134f);
  padding: 0.65rem 1.1rem;
  color: white;
  font-weight: 700;
  text-shadow: 0 1px 5px rgba(0, 0, 0, 0.6);
  box-shadow: 0 5px 0 #35103e, 0 8px 18px rgba(0, 0, 0, 0.32), inset 0 1px rgba(255, 255, 255, 0.2);
  transition: transform 180ms ease, background 180ms ease, box-shadow 180ms ease, border-color 180ms ease, filter 180ms ease;
}

.spooky-button::after {
  position: absolute;
  z-index: -1;
  inset: 3px;
  border: 1px solid rgba(255, 229, 200, 0.14);
  border-radius: 0.45rem 0.68rem 0.45rem 0.68rem;
  content: "";
  pointer-events: none;
}

.spooky-button > span {
  transition: transform 180ms ease;
}

.spooky-button:hover {
  transform: translateY(-3px);
  border-color: #ffd19a;
  background:
    linear-gradient(125deg, rgba(255, 255, 255, 0.2), transparent 44%),
    linear-gradient(135deg, #de5b1d, #a73725 54%, #68206f);
  color: #fffaf1;
  box-shadow: 0 7px 0 #35103e, 0 12px 26px rgba(206, 75, 28, 0.3), 0 0 18px rgba(255, 128, 57, 0.28), inset 0 1px rgba(255, 255, 255, 0.3);
  filter: saturate(1.18);
}

.spooky-button:hover > span:last-child {
  transform: translateX(4px);
}

.spooky-button:active {
  transform: translateY(3px);
  box-shadow: 0 2px 0 #35103e, 0 4px 10px rgba(0, 0, 0, 0.3), inset 0 1px rgba(255, 255, 255, 0.16);
}

.spooky-button:disabled {
  cursor: not-allowed;
  filter: grayscale(0.75);
  opacity: 0.58;
  transform: none;
}

.spooky-button-muted {
  border-color: rgba(190, 139, 204, 0.54);
  background:
    linear-gradient(130deg, rgba(255, 255, 255, 0.08), transparent 45%),
    linear-gradient(135deg, #472257, #271336);
  box-shadow: 0 5px 0 #170b20, 0 8px 18px rgba(0, 0, 0, 0.32), inset 0 1px rgba(255, 255, 255, 0.12);
}

.spooky-button-muted:hover {
  background:
    linear-gradient(130deg, rgba(255, 255, 255, 0.14), transparent 45%),
    linear-gradient(135deg, #71337b, #39204c);
  box-shadow: 0 7px 0 #170b20, 0 12px 25px rgba(113, 51, 123, 0.28);
}

.spooky-input {
  border: 1px solid rgba(152, 74, 184, 0.55);
  border-radius: 0.6rem;
  background: rgba(7, 5, 12, 0.8);
  padding: 0.65rem 0.75rem;
  color: #f5eafa;
}

.spooky-input::placeholder {
  color: rgba(211, 191, 220, 0.42);
}

.spooky-input:focus {
  border-color: #ff8533;
  outline: none;
}

.spooky-input option {
  background: #17101e;
}

.prompt-card {
  border: 1px solid rgba(57, 255, 20, 0.2);
  border-radius: 0.75rem;
  background: rgba(4, 17, 11, 0.55);
  padding: 0.85rem;
  color: #e8ffe5;
  line-height: 1.55;
}

.nav-tab {
  position: relative;
  overflow: hidden;
  border: 1px solid rgba(154, 96, 173, 0.48);
  border-radius: 0.7rem 0.95rem 0.7rem 0.95rem;
  background: linear-gradient(145deg, rgba(46, 27, 59, 0.94), rgba(15, 10, 23, 0.94));
  padding: 0.65rem 1rem;
  color: rgba(249, 238, 250, 0.91);
  font-size: 0.82rem;
  font-weight: 700;
  box-shadow: 0 4px 0 rgba(5, 3, 8, 0.7), inset 0 1px rgba(255, 255, 255, 0.07);
  transition: transform 180ms ease, background 180ms ease, border-color 180ms ease, color 180ms ease, box-shadow 180ms ease;
}

.nav-tab:hover {
  transform: translateY(-2px);
  border-color: rgba(255, 155, 86, 0.8);
  color: #ffd6b0;
  box-shadow: 0 6px 12px rgba(0, 0, 0, 0.3), 0 0 18px rgba(255, 113, 43, 0.12);
}

.nav-tab-active {
  border-color: rgba(255, 174, 106, 0.9);
  background: linear-gradient(145deg, #b8491d, #70214e 90%);
  color: #fff5e9;
  box-shadow: 0 4px 0 #391128, 0 0 22px rgba(255, 102, 32, 0.28), inset 0 1px rgba(255, 255, 255, 0.2);
}

.sound-button {
  border: 1px solid rgba(152, 74, 184, 0.55);
  border-radius: 999px;
  background: rgba(12, 8, 17, 0.88);
  padding: 0.45rem 0.75rem;
  color: #eee1f5;
  font-size: 0.75rem;
  font-weight: 700;
  transition: border-color 160ms ease, color 160ms ease;
}

.sound-button:hover,
.sound-button-active {
  border-color: #ffac68;
  background: rgba(93, 38, 42, 0.92);
  color: #ffd2a9;
  box-shadow: 0 0 20px rgba(255, 111, 44, 0.18);
}

.team-score-panel {
  position: relative;
  overflow: hidden;
  border-color: rgba(255, 124, 54, 0.44);
  background:
    radial-gradient(ellipse at 4% 0%, rgba(226, 92, 40, 0.13), transparent 50%),
    linear-gradient(145deg, rgba(33, 17, 40, 0.96), rgba(11, 8, 15, 0.95));
  box-shadow: 0 14px 34px rgba(0, 0, 0, 0.3), inset 0 1px rgba(255, 206, 166, 0.08);
}

.team-score-chip {
  min-height: 2.85rem;
  border-color: rgba(255, 137, 71, 0.48);
  border-radius: 0.8rem 1rem 0.8rem 1rem;
  background: linear-gradient(145deg, rgba(54, 27, 55, 0.96), rgba(21, 12, 27, 0.97));
  box-shadow: inset 0 1px rgba(255, 255, 255, 0.07);
}

.team-identity {
  display: inline-flex;
  min-width: 0;
  align-items: center;
  gap: 0.35rem;
}

.team-emoji-select {
  width: 2rem;
  height: 2rem;
  appearance: none;
  border: 1px solid rgba(255, 152, 86, 0.26);
  border-radius: 0.55rem;
  background: rgba(7, 5, 12, 0.64);
  padding: 0.12rem;
  color: #fff;
  font-size: 1.15rem;
  line-height: 1;
  text-align: center;
  cursor: pointer;
  transition: border-color 160ms ease, background 160ms ease, box-shadow 160ms ease;
}

.team-emoji-select:hover,
.team-emoji-select:focus-visible {
  border-color: #ff9a59;
  background: rgba(83, 37, 45, 0.84);
  box-shadow: 0 0 12px rgba(255, 127, 55, 0.2);
}

.team-emoji-select option {
  background: #1a1021;
  color: white;
  font-size: 1.25rem;
}

.team-name {
  overflow: hidden;
  max-width: 10rem;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.team-delete-control {
  display: grid;
  width: 1.65rem;
  height: 1.65rem;
  flex: 0 0 auto;
  place-items: center;
  border: 1px solid rgba(255, 104, 104, 0.28);
  border-radius: 50%;
  background: rgba(60, 12, 23, 0.38);
  color: rgba(255, 151, 151, 0.78);
  font-size: 1.1rem;
  font-weight: 700;
  line-height: 1;
  transition: transform 160ms ease, color 160ms ease, background 160ms ease, box-shadow 160ms ease;
}

.team-delete-control:hover {
  transform: rotate(90deg) scale(1.08);
  background: rgba(139, 31, 40, 0.68);
  color: #fff;
  box-shadow: 0 0 12px rgba(255, 73, 73, 0.24);
}

.score-control {
  display: grid;
  width: 1.65rem;
  height: 1.65rem;
  place-items: center;
  border: 1px solid rgba(255, 255, 255, 0.12);
  border-radius: 0.5rem;
  background: rgba(0, 0, 0, 0.38);
  font-size: 1rem;
  font-weight: 900;
  line-height: 1;
  transition: transform 160ms ease, background 160ms ease, box-shadow 160ms ease;
}

.score-control:hover {
  transform: translateY(-2px) scale(1.08);
  background: rgba(255, 255, 255, 0.1);
  box-shadow: 0 0 12px currentColor;
}

.score-control-add {
  color: #c5ff76;
}

.score-control-remove {
  color: #ff8585;
}

.team-name-input {
  min-width: 10rem;
}

.team-add-button {
  min-height: 2.45rem;
  border-radius: 0.55rem 0.8rem 0.55rem 0.8rem;
  padding: 0.45rem 0.8rem;
  font-size: 0.78rem;
}

.jeopardy-category {
  min-height: 0;
  padding: 0.4rem 0.55rem;
  border-color: rgba(255, 156, 78, 0.7);
  border-radius: 0.85rem 1.2rem 0.85rem 1.2rem;
  background: linear-gradient(145deg, rgba(104, 35, 91, 0.96), rgba(34, 15, 52, 0.98));
  box-shadow: inset 0 0 20px rgba(238, 116, 49, 0.08), 0 8px 18px rgba(0, 0, 0, 0.28);
}

.jeopardy-board {
  width: 100%;
}

.jeopardy-grid {
  grid-template-rows: 3.2rem repeat(5, minmax(2.6rem, 1fr));
  gap: clamp(0.35rem, 0.7vw, 0.65rem);
}

.jeopardy-category h3 {
  font-size: clamp(0.7rem, 1vw, 0.95rem);
  line-height: 1.15;
}

.jeopardy-tile {
  display: flex;
  min-width: 0;
  min-height: 2.6rem;
  align-items: center;
  justify-content: center;
  border: 1px solid rgba(182, 104, 199, 0.58);
  border-radius: 0.7rem 0.95rem 0.7rem 0.95rem;
  font-size: clamp(1.05rem, 2vw, 1.6rem);
  font-weight: 900;
  line-height: 1;
  transition: transform 160ms ease, border-color 160ms ease, background 160ms ease, box-shadow 160ms ease;
}

.jeopardy-tile:not(:disabled) {
  position: relative;
  overflow: hidden;
  border-color: rgba(182, 104, 199, 0.58);
  border-radius: 0.85rem 1.15rem 0.85rem 1.15rem;
  background:
    radial-gradient(circle at 50% 0%, rgba(255, 129, 55, 0.16), transparent 68%),
    linear-gradient(145deg, #261538, #0d0a15);
  color: #ffad63;
  text-shadow: 0 0 16px rgba(255, 123, 45, 0.32);
  box-shadow: inset 0 1px rgba(255, 255, 255, 0.1), 0 5px 0 #09070e, 0 9px 16px rgba(0, 0, 0, 0.23);
}

.jeopardy-tile:not(:disabled):hover {
  transform: translateY(-2px) scale(1.025);
  border-color: #ffbe76;
  background:
    radial-gradient(circle at 50% 0%, rgba(255, 207, 125, 0.3), transparent 70%),
    linear-gradient(145deg, #733020, #36153b);
  color: #fff1d2;
  box-shadow: inset 0 1px rgba(255, 255, 255, 0.22), 0 7px 0 #09070e, 0 0 22px rgba(255, 121, 45, 0.3);
}

.jeopardy-tile-empty {
  flex-direction: column;
  gap: 0.18rem;
  border-style: dashed;
  border-color: rgba(145, 105, 154, 0.35);
  background: rgba(17, 12, 24, 0.58);
  color: rgba(218, 172, 221, 0.45);
  cursor: not-allowed;
}

.jeopardy-tile-empty small {
  font-size: 0.55rem;
  font-weight: 600;
  line-height: 1;
}

.app-shell-jeopardy {
  display: flex;
  height: 100vh;
  height: 100dvh;
  min-height: 0;
  flex-direction: column;
  overflow: hidden;
  padding-bottom: 0;
}

.jeopardy-header {
  flex: 0 0 auto;
  padding: 0.45rem 0 0;
}

.jeopardy-header .youtube-music {
  position: absolute;
  top: 0.45rem;
  right: 0;
  margin: 0;
}

.jeopardy-header .youtube-music-open {
  z-index: 4;
}

.jeopardy-header .youtube-player {
  position: absolute;
  top: calc(100% + 0.5rem);
  right: 0;
  width: min(32rem, 76vw);
}

.jeopardy-main {
  display: flex;
  min-height: 0;
  flex: 1 1 auto;
  flex-direction: column;
  margin-top: 0.35rem;
}

.jeopardy-layout {
  display: grid;
  min-height: 0;
  flex: 1 1 auto;
  grid-template-rows: auto minmax(0, 1fr);
  gap: 0.55rem;
}

.jeopardy-layout .team-score-panel {
  min-height: 0;
  justify-content: space-between;
  gap: 0.55rem 1rem;
  margin-bottom: 0;
  padding: 0.5rem 0.65rem;
}

.jeopardy-layout .team-score-panel > div:first-child {
  gap: 0.5rem;
}

.jeopardy-layout .team-score-chip {
  min-height: 2.35rem;
  gap: 0.35rem;
  padding: 0.25rem 0.4rem;
  font-size: 0.78rem;
}

.jeopardy-layout .team-emoji-select {
  width: 1.7rem;
  height: 1.7rem;
  font-size: 1rem;
}

.jeopardy-layout .team-delete-control,
.jeopardy-layout .score-control {
  width: 1.45rem;
  height: 1.45rem;
}

.jeopardy-layout .team-name-input {
  width: 10rem;
  min-width: 0;
  padding: 0.42rem 0.6rem;
  font-size: 0.78rem;
}

.jeopardy-layout .team-add-button {
  min-height: 2.15rem;
}

.jeopardy-board-panel {
  display: flex;
  min-height: 0;
  flex-direction: column;
  overflow: hidden;
  padding: 0.6rem;
}

.jeopardy-instructions {
  display: none;
}

.jeopardy-board-panel .jeopardy-board {
  min-height: 0;
  flex: 1 1 auto;
}

.jeopardy-board-panel .jeopardy-grid {
  height: 100%;
}

.question-backdrop {
  background:
    radial-gradient(ellipse at 50% 35%, rgba(100, 34, 104, 0.31), transparent 48%),
    rgba(4, 2, 8, 0.84);
  animation: veil-in 220ms ease-out both;
}

.question-dialog {
  position: relative;
  max-height: calc(100dvh - 2rem);
  overflow-y: auto;
  border-color: rgba(255, 145, 75, 0.82);
  background:
    radial-gradient(ellipse at 50% 0%, rgba(111, 37, 109, 0.3), transparent 54%),
    linear-gradient(145deg, rgba(32, 18, 40, 0.99), rgba(10, 7, 14, 0.99));
  box-shadow: 0 0 0 1px rgba(255, 194, 128, 0.12), 0 28px 90px rgba(0, 0, 0, 0.75), 0 0 60px rgba(166, 54, 41, 0.18);
  animation: coffin-rise 280ms cubic-bezier(0.18, 0.8, 0.3, 1) both;
}

.question-dialog::before {
  position: absolute;
  inset: 9px;
  border: 1px solid rgba(199, 142, 194, 0.13);
  border-radius: 1.2rem;
  content: "";
  pointer-events: none;
}

.question-category {
  color: #e6a1e2;
}

.question-text {
  min-height: 0;
  margin-bottom: 1rem;
  text-shadow: 0 0 22px rgba(255, 217, 180, 0.16);
}

.answer-reveal {
  border-radius: 0.75rem 1.1rem 0.75rem 1.1rem;
  background: linear-gradient(135deg, rgba(29, 66, 35, 0.55), rgba(9, 20, 13, 0.76));
  box-shadow: inset 0 0 25px rgba(144, 255, 103, 0.05), 0 0 18px rgba(116, 205, 76, 0.07);
}

.team-award-button {
  min-height: 2.7rem;
  border-radius: 0.55rem 0.85rem 0.55rem 0.85rem;
}

.ghost-dismiss-button {
  min-height: 2.7rem;
  border: 1px solid rgba(172, 171, 190, 0.3);
  border-radius: 0.55rem 0.85rem 0.55rem 0.85rem;
  background: linear-gradient(145deg, rgba(48, 44, 58, 0.85), rgba(17, 15, 23, 0.95));
  color: rgba(226, 221, 234, 0.8);
  font-weight: 700;
  transition: border-color 160ms ease, color 160ms ease, transform 160ms ease;
}

.ghost-dismiss-button:hover {
  transform: translateY(-2px);
  border-color: rgba(208, 193, 224, 0.65);
  color: white;
}

.modal-close-button {
  color: rgba(202, 190, 209, 0.66);
  text-decoration-color: rgba(202, 190, 209, 0.32);
  text-underline-offset: 4px;
  transition: color 160ms ease, text-decoration-color 160ms ease;
}

.modal-close-button:hover {
  color: #ffbd94;
  text-decoration-color: currentColor;
}

@keyframes veil-in {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes coffin-rise {
  from { opacity: 0; transform: translateY(18px) scale(0.97); }
  to { opacity: 1; transform: translateY(0) scale(1); }
}

.page-header {
  position: relative;
  padding: 2rem 0 1.25rem;
  text-align: center;
}

.game-header {
  padding-top: 1.25rem;
}

.game-topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.75rem;
}

.game-topbar .spooky-button {
  flex: 0 0 auto;
}

.game-topbar-spacer {
  width: 7rem;
  flex: 0 0 auto;
}

.youtube-music {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.75rem;
  margin-top: 1rem;
}

.youtube-player {
  width: min(100%, 38rem);
  overflow: hidden;
  border: 1px solid rgba(152, 74, 184, 0.42);
  border-radius: 1rem;
  background: #08050d;
  box-shadow: 0 18px 48px rgba(0, 0, 0, 0.42);
}

.youtube-player iframe {
  display: block;
  width: 100%;
  aspect-ratio: 16 / 9;
  border: 0;
}

.youtube-link {
  display: block;
  padding: 0.6rem 0.8rem;
  color: rgba(238, 225, 245, 0.68);
  font-size: 0.75rem;
  text-align: center;
  text-decoration: underline;
  text-underline-offset: 3px;
}

.youtube-link:hover {
  color: #ffb47d;
}

.home-main {
  margin-top: 1.25rem;
}

.game-main {
  margin-top: 1rem;
}

@media (max-width: 640px) {
  .sound-button {
    max-width: 100%;
    font-size: 0.65rem;
  }

  body::before,
  body::after {
    opacity: 0.15;
  }

  .blood-moon {
    top: 4.5rem;
    right: -1.5rem;
    width: 5.2rem;
    opacity: 0.4;
  }

  .lightning-glow {
    left: 70%;
    height: 17rem;
  }

  .page-header {
    padding-top: 1.25rem;
  }

  .game-topbar {
    gap: 0.35rem;
  }

  .game-topbar .spooky-button {
    min-height: 2.4rem;
    padding: 0.45rem 0.6rem;
    font-size: 0.75rem;
  }

  .game-topbar-spacer {
    width: 3.5rem;
  }

  .hero-card {
    min-height: 27rem;
    padding: 1.4rem;
  }

  .hero-card::before {
    background-position: center, center, 42% center;
    background-size: cover, cover, 210% auto;
  }

  .hero-promises {
    gap: 0.45rem 0.8rem;
    font-size: 0.64rem;
  }

  .game-card-tag {
    font-size: 0.55rem;
  }

  .question-dialog {
    padding: 1.15rem;
  }

  .team-score-panel {
    padding: 0.85rem;
  }
}

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    scroll-behavior: auto !important;
    transition-duration: 0.01ms !important;
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
  }

  .haunting-atmosphere::after,
  .lightning-glow {
    display: none;
  }
}
